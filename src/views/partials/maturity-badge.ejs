<%
/**
 * Maturity badge partial.
 * Required locals: maturity_level (string), maturity_label (string)
 * Color map per UX-Mockup §Color System for Trust Signals:
 *   IDEA              → badge--maturity-idea           (#6B7280 gray)
 *   EXPERIMENT_POC    → badge--maturity-experiment     (#D97706 amber)
 *   PROTOTYPE_PILOT   → badge--maturity-prototype      (#EA580C orange)
 *   PRODUCTION_VALIDATED → badge--maturity-production  (#16A34A green)
 *   ARCHIVED          → badge--maturity-archived       (#374151 dark-gray)
 */
const maturityClassMap = {
  IDEA: 'badge--maturity-idea',
  EXPERIMENT_POC: 'badge--maturity-experiment',
  PROTOTYPE_PILOT: 'badge--maturity-prototype',
  PRODUCTION_VALIDATED: 'badge--maturity-production',
  ARCHIVED: 'badge--maturity-archived',
};
const badgeClass = maturityClassMap[maturity_level] || 'badge--maturity-idea';
%>
<span
  class="badge badge--maturity <%= badgeClass %>"
  aria-label="Maturity: <%= maturity_label %>"
  data-testid="maturity-badge"
  data-maturity="<%= maturity_level %>"
>
  <span aria-hidden="true">●</span>
  <%= maturity_label %>
</span>
