<header class="top-nav" data-testid="top-nav">
  <div class="top-nav__inner">
    <!-- Logo / Hub title -->
    <a href="/catalog" class="top-nav__brand" aria-label="TSIO Innovation Hub — go to catalog">
      TSIO Innovation Hub
    </a>

    <!-- Primary navigation links -->
    <nav aria-label="Primary navigation" class="top-nav__links">
      <a href="/catalog" class="top-nav__link" data-testid="nav-catalog">Catalog</a>
      <a href="/submit-opportunity" class="top-nav__link" data-testid="nav-submit-opportunity">Submit a Mission Problem</a>
      <a href="/share-innovation" class="top-nav__link" data-testid="nav-share-innovation">Share Your Innovation Work</a>
    </nav>

    <!-- Global search bar — pre-filled with current query on /search page -->
    <form action="/search" method="get" role="search" class="top-nav__search">
      <label for="global-search-input" class="sr-only">Search innovation records</label>
      <input
        type="search"
        id="global-search-input"
        name="q"
        placeholder="Search innovation records…"
        class="top-nav__search-input"
        aria-label="Search innovation records"
        data-testid="global-search-input"
        value="<%= typeof currentQuery !== 'undefined' ? currentQuery : '' %>"
      />
      <button type="submit" class="top-nav__search-btn" aria-label="Submit search" data-testid="global-search-submit">
        <span aria-hidden="true">🔍</span>
      </button>
    </form>
  </div>
</header>
